{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Économat BOULANGERIE PRO",
  "version": "1.0.0",
  "identifier": "fr.emmanuelpradie.economatboulangeriepro",
  "build": {
    "frontendDist": "../",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Économat BOULANGERIE PRO",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "nsis": {
        "installMode": "perUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Économat BOULANGERIE PRO",
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true
      }
    }
  }
}